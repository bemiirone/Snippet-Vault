{
  "version": 2,
  "buildCommand": "npm install && npm run build:vercel",
  "builds": [
    {
      "src": "api/src/serverless.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/src/serverless.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
