{
  "buildCommand": "npm install && npm run build:web && npm run build:api",
  "outputDirectory": "web/dist/snippet-vault/browser",
  "functions": {
    "api/src/serverless.ts": {
      "runtime": "@vercel/node@5"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "api/src/serverless.ts" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
