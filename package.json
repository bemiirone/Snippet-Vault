{
  "name": "snippet-vault",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "web",
    "api",
    "cli"
  ],
  "scripts": {
    "dev:web": "npm start --workspace=web",
    "dev:api": "npm start --workspace=api",
    "dev:cli": "npm start --workspace=cli",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "build:cli": "npm run build --workspace=cli",
    "test:web": "npm test --workspace=web",
    "test:api": "npm test --workspace=api",
    "test:cli": "npm test --workspace=cli",
    "format": "npx prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
